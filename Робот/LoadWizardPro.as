  IF .sh1 AND .grip.st3.eq0 AND .grip.st6.ne0 THEN
    state = 9
    RETURN
  END
  ;
  ; Close shelf
  .ge = .grip.st3.eq0 AND .grip.st6.eq0
  .ce = .chuck.st5.eq0 AND .chuck.st6.eq0
  IF .sh1 AND .ge AND .ce AND .max.pick
